{
    "name": "win-up-to-date",
    "version": "1.0.0-beta.1",
    "description": "A website project showing the latest status of Windows Insider versions.",
    "author": "crrashh1542 <1542@crrashh.com>",
    "homepage": "https://wutd.crrashh.com",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/crrashh1542/win-up-to-date"
    },
    "license": "GPL-3.0",
    "private": true,
    "bugs": {
        "url": "https://github.com/crrashh1542/win-up-to-date/issues"
    },
    "scripts": {
        "dev": "concurrently -n web,api \"pnpm dev:web\" \"pnpm dev:api\"",
        "dev:web": "vite",
        "dev:api": "node server/main.js",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint \"src/**/*.{js,ts,vue}\"",
        "lint:fix": "pnpm lint -- --fix",
        "p:check": "prettier . --check",
        "p:write": "prettier . --write",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.1.1",
        "@types/nprogress": "^0.2.3",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "concurrently": "^10.0.3",
        "eslint": "^10.7.0",
        "eslint-plugin-vue": "^10.10.0",
        "husky": "^9.1.7",
        "less": "^4.7.0",
        "lint-staged": "^17.1.0",
        "prettier": "^3.9.6",
        "typescript": "^7.0.2",
        "vite": "^8.1.5",
        "vite-plugin-pwa": "^1.3.0",
        "vue-eslint-parser": "^10.4.1"
    },
    "dependencies": {
        "@iconify-vue/fluent": "^1.0.5",
        "@iconify-vue/fluent-color": "^1.0.6",
        "axios": "^1.18.1",
        "modern-normalize": "^3.0.1",
        "nprogress": "^0.2.0",
        "pinia": "^4.0.2",
        "pinia-plugin-persistedstate": "^4.7.1",
        "vue": "^3.5.40",
        "vue-router": "^5.2.0"
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not dead",
        "not ie 11"
    ],
    "lint-staged": {
        "*.{js,ts,css,less,vue}": "prettier --write"
    }
}
